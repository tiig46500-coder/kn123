# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_USERNAME / ADMIN_PASSWORD / SESSION_SECRET:
# Optional server-side credentials for /admin (defaults initialized safely on server boot)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_DEPLOY"
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"

# OPTIONAL DURABLE IMAGE STORAGE FOR /admin UPLOADS ON VERCEL
# Configure either Supabase Storage OR Cloudinary in Vercel Project Environment Variables.
# Leave unset for local disk storage (dev) or temporary serverless uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="langxanh-images"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="langxanh"
